{
  "name": "slidedeck",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "node --watch server/index.js",
    "build": "npm run build --prefix client",
    "lint": "oxlint server && npm run lint --prefix client",
    "preview": "npm run preview --prefix client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0"
  }
}